{
  "name": "misbahuda-mobile",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:web": "cd ../web && npm run build",
    "sync": "npx cap sync",
    "sync:ios": "npx cap sync ios",
    "sync:android": "npx cap sync android",
    "open:ios": "npx cap open ios",
    "open:android": "npx cap open android",
    "run:ios": "npm run build:web && npm run sync:ios",
    "run:android": "npm run build:web && npm run sync:android && npm run open:android"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
